---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<span class="cite-wrapper"><a href={`#ref-${id}`} class="citation" role="doc-noteref"><sup>[<span class="cite-key" data-cite={id}></span>]</sup></a><span class="cite-tooltip" data-cite-tooltip={id}></span></span>

<style>
  .cite-wrapper {
    position: relative;
    display: inline;
    line-height: 0;
  }

  .citation {
    text-decoration: none;
    color: var(--text-secondary);
    cursor: pointer;
    &:hover { color: var(--text-primary); }
  }

  .citation sup {
    font-size: 0.7em;
    line-height: 0;
    vertical-align: baseline;
    position: relative;
    top: -0.5em;
  }

  .cite-tooltip {
    display: none;
    position: absolute;
    bottom: 1.2em;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.5em 0.75em;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary);
    white-space: normal;
    width: max-content;
    max-width: 360px;
    z-index: 50;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  .cite-wrapper:hover .cite-tooltip {
    display: block;
  }
</style>
