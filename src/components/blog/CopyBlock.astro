---
/**
 * A block of preformatted text with a copy button — the same markup the
 * rehype-blocks plugin produces for fenced code, for use from layouts.
 */
interface Props {
  text: string;
  lang?: string;
  copyLabel: string;
  copiedLabel: string;
}

const { text, lang, copyLabel, copiedLabel } = Astro.props;
---

<div class="code-block" data-lang={lang}>
  <button type="button" class="copy-button" aria-label={copyLabel} data-copied={copiedLabel}>
    <svg class="icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
    <svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  </button>
  <pre><code>{text}</code></pre>
</div>
