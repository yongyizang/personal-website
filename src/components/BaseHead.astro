---
// Roboto, self-hosted. The package splits it by script with unicode-range, so
// only the Latin file (preloaded below) is fetched for ordinary pages.
import '@fontsource-variable/roboto';
import '@fontsource-variable/roboto/wght-italic.css';
import robotoLatin from '@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url';
import '../styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import { site, type Locale } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: { src: string; alt?: string; width?: number; height?: number };
  lang?: Locale;
  // Set on posts: turns the page into an Open Graph "article".
  article?: { published: Date; modified?: Date; authors: string[]; tags: string[] };
}

const { title, description, image, lang = 'en', article } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Link previews. A post passes its cover and gets the large card; every other
// page shows the profile photo in the small square card.
//   X         reads the twitter:* tags and falls back to og:*.
//   LinkedIn  reads og:* plus the author and publish date (it calls the
//             latter og:publish_date).
//   WeChat    reads og:* when a link is shared into it from another app. Its
//             own "send to chat" menu ignores them unless the site signs in to
//             the JS-SDK (which needs an Official Account): the card then
//             shows <title> and the first image on the page that is at least
//             300px wide, cropped to a square.
const shareImage = image ?? { src: site.profileImage, alt: site.name[lang] };
const shareImageURL = new URL(shareImage.src, Astro.site);
const author = article?.authors.join(', ') || site.name[lang];

// Google Analytics, production builds only. The client router changes pages
// with history.pushState, which GA4 counts by itself ("Page changes based on
// browser history events", on by default under Enhanced measurement), so no
// page view is sent by hand.
const gaId = import.meta.env.PROD ? site.googleAnalyticsId : undefined;

// Browser-chrome tint. Keep in sync with --bg-primary in styles/_dark-mode.scss.
const themeColors = { light: '#fafaf7', dark: '#1a1a1b' };
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)" />
  <link rel="preload" as="font" type="font/woff2" href={robotoLatin} crossorigin />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <meta name="robots" content="all" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={site.name[lang]} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={shareImageURL} />
  {shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
  {shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}
  {shareImage.alt && <meta property="og:image:alt" content={shareImage.alt} />}
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
  {article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
      {article.authors.map(name => <meta property="article:author" content={name} />)}
      {article.tags.map(tag => <meta property="article:tag" content={tag} />)}
      <meta name="publish_date" property="og:publish_date" content={article.published.toISOString()} />
    </>
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:site" content="@yongyi_zang" />
  <meta name="twitter:creator" content="@yongyi_zang" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImageURL} />
  {shareImage.alt && <meta name="twitter:image:alt" content={shareImage.alt} />}

  <!-- View Transitions (animations live in styles/_motion.scss) -->
  <ClientRouter />

  <!-- Theme + first-load entrance. Runs before first paint. -->
  <script is:inline define:vars={{ themeColors }}>
    (function () {
      var root = document.documentElement;
      var theme = null;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme === 'light' || theme === 'dark') {
        root.setAttribute('data-theme', theme);
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
          m.setAttribute('content', themeColors[theme]);
        });
      }
      root.classList.add('intro');
    })();
  </script>

  <!-- Google Analytics -->
  {gaId && (
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId);

      // googletagmanager.com can't be reached from mainland China. Ask for it
      // only once the page has finished loading, so a request that hangs never
      // holds the page's own loading (or the progress bar in WeChat's browser).
      function loadTag() {
        setTimeout(function () {
          var tag = document.createElement('script');
          tag.async = true;
          tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
          document.head.appendChild(tag);
        }, 0);
      }
      if (document.readyState === 'complete') loadTag();
      else window.addEventListener('load', loadTag, { once: true });
    </script>
  )}
</head>
