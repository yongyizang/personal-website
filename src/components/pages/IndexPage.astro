---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchIsland from '../search/SearchIsland';
import BlogList from '../blog/BlogList.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';
import { site, news } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Blog posts filtered to the current locale. Drafts are listed while running
// `npm run dev` (so they can be previewed) and left out of the build.
const allPosts = await getCollection('blog');
const posts = allPosts.filter(p => p.data.lang === locale && (import.meta.env.DEV || !p.data.draft));

// Bio is authored as MDX (src/content/bio/*.mdx) so it can contain links and
// other markdown. Short is shown by default; long is revealed on toggle.
const bios = await getCollection('bio');
const shortBioEntry = bios.find(b => b.data.lang === locale && b.data.variant === 'short');
const longBioEntry = bios.find(b => b.data.lang === locale && b.data.variant === 'long');
const { Content: ShortBio } = await render(shortBioEntry!);
const { Content: LongBio } = await render(longBioEntry!);

// Name, description, profile image, social links, news items are all pulled
// from src/content/site.yaml and src/content/news.yaml — edit those files to
// change the home page content.
const name = site.name[locale];
const description = site.description[locale];

// The newest entry is always visible; the rest unfold beneath it.
const [latestNews, ...olderNews] = news;
const isoDate = (date: string) => (/^\d{4}(-\d{2}){0,2}$/.test(date) ? date : undefined);
---

<BaseLayout title={name} description={description}>
  <div class="page-wrap">
    <header class="site-header">
      <div class="header-top">
        <div class="header-text">
          <div class="header-name reveal" style="--reveal-order: 0">
            <img src={site.profileImage} alt={name} class="profile-photo profile-mobile" width="56" height="56" decoding="async" />
            <h1>{name}</h1>
          </div>
          <div class="bio-wrap reveal" id="bio-wrap" style="--reveal-order: 1">
            <div class="bio-row bio-row-short"><div class="bio bio-short" id="bio-short"><ShortBio /></div></div>
            <div class="bio-row bio-row-long"><div class="bio bio-long" id="bio-long"><LongBio /></div></div>
            <button
              class="bio-toggle" id="bio-toggle" type="button"
              aria-expanded="false" aria-controls="bio-long"
              data-more={t(locale, 'home.bioMore')}
              data-less={t(locale, 'home.bioLess')}
            >
              <span class="bio-toggle-label">{t(locale, 'home.bioMore')}</span>
              <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>
            </button>
          </div>
          <nav class="links reveal" style="--reveal-order: 2" aria-label={t(locale, 'home.links')}>
            {site.links.map(link => (
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            ))}
          </nav>
        </div>
        <img src={site.profileImage} alt={name} class="profile-photo profile-desktop reveal" style="--reveal-order: 1" width="150" height="150" decoding="async" />
      </div>
    </header>

    {latestNews && (
      <div class="news reveal" id="news" style="--reveal-order: 3">
        {olderNews.length > 0 ? (
          <button class="news-item news-latest" id="news-toggle" type="button" aria-expanded="false" aria-controls="news-more">
            <time datetime={isoDate(latestNews.date)}>{latestNews.date}</time>
            <span class="news-text">{latestNews[locale]}</span>
            <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>
          </button>
        ) : (
          <p class="news-item news-latest">
            <time datetime={isoDate(latestNews.date)}>{latestNews.date}</time>
            <span class="news-text">{latestNews[locale]}</span>
          </p>
        )}
        {olderNews.length > 0 && (
          <div class="news-more" id="news-more">
            <div class="news-clip">
              <ul>
                {olderNews.map(item => (
                  <li class="news-item">
                    <time datetime={isoDate(item.date)}>{item.date}</time>
                    <span class="news-text">{item[locale]}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>
    )}

    <section class="blog-section reveal" style="--reveal-order: 4">
      {posts.length > 0 && <SearchIsland client:idle locale={locale} />}
      <BlogList posts={posts} locale={locale} />
    </section>
  </div>
</BaseLayout>

<style lang="scss">
  @use '../../styles/variables' as *;

  .page-wrap {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-header {
    padding: 4.75rem 0 1.75rem;
  }

  // Top-aligned, so the photo stays put while the bio unfolds beside it.
  .header-top {
    display: flex;
    align-items: flex-start;
  }

  .header-text {
    flex: 1;
    min-width: 0;
  }

  .header-name {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .profile-photo {
    object-fit: cover;
    flex-shrink: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--border-color);
  }

  .profile-mobile {
    width: 56px;
    height: 56px;
  }

  .profile-desktop {
    display: none;
    width: 150px;
    height: 150px;
    // Optically level with the cap height of the name.
    margin-top: 0.35rem;
  }

  @media (min-width: $small-device) {
    .site-header {
      padding-top: clamp(4.75rem, 11vh, 6.5rem);
    }

    .header-top {
      gap: 2.5rem;
    }

    .profile-mobile {
      display: none;
    }

    .profile-desktop {
      display: block;
    }
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: $small-device) {
    h1 { font-size: 2.75rem; }
  }

  .bio-wrap {
    margin-top: 1rem;
  }

  // Short and long bio each sit in a one-row grid whose row animates between
  // 0fr and 1fr. As one closes the other opens, so the block's height glides
  // from one text to the other with no measuring in script.
  //
  // The text stays visible while its row moves — unrolled as the block opens,
  // rolled back up as it closes — so the fades are short and timed per direction.
  //
  // The row itself does the clipping. (Mid-transition a fractional track ends
  // up shorter than its auto-sized grid, so clipping on the item instead would
  // reveal the text more slowly than the block opens and leave a gap below it.)
  .bio-row {
    --bio-dur: 0.6s;
    --bio-ease: cubic-bezier(0.32, 0.72, 0, 1);
    display: grid;
    overflow: hidden;
    // A little room each side so focus rings on links aren't cropped.
    padding-inline: 4px;
    margin-inline: -4px;
  }

  .bio-row-short {
    grid-template-rows: 1fr;
    // Collapsing: the one-liner returns once the long text has mostly rolled up.
    transition:
      grid-template-rows var(--bio-dur) var(--bio-ease),
      opacity 0.25s ease 0.12s,
      visibility 0s;
  }

  .bio-row-long {
    grid-template-rows: 0fr;
    opacity: 0;
    // Also takes the hidden text (and its links) out of the tab order.
    visibility: hidden;
    // Collapsing: stay readable while rolling up, fade out near the end.
    transition:
      grid-template-rows var(--bio-dur) var(--bio-ease),
      opacity 0.2s ease 0.14s,
      visibility 0s linear var(--bio-dur);
  }

  .bio-wrap.expanded .bio-row-short {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    // Expanding: the one-liner gets out of the way at once.
    transition:
      grid-template-rows var(--bio-dur) var(--bio-ease),
      opacity 0.1s ease,
      visibility 0s linear var(--bio-dur);
  }

  .bio-wrap.expanded .bio-row-long {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    // Expanding: the long text is there from the first frame, unrolling downward.
    transition:
      grid-template-rows var(--bio-dur) var(--bio-ease),
      opacity 0.18s ease,
      visibility 0s;
  }

  .bio {
    min-height: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);

    :global(p) { margin: 0; }
    :global(p + p) { margin-top: 0.85em; }
    :global(a) {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--text-tertiary);
      text-underline-offset: 0.18em;
      transition: color var(--dur-fast) ease, text-decoration-color var(--dur-fast) ease;
      &:hover {
        color: var(--text-primary);
        text-decoration-color: currentColor;
      }
    }
  }

  .chevron {
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .bio-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.3rem;
    padding: 0.25rem 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--text-tertiary);
    cursor: pointer;
    transition: color var(--dur-fast) ease;

    &:hover {
      color: var(--text-primary);
    }
  }

  .bio-wrap.expanded .bio-toggle .chevron {
    transform: rotate(180deg);
  }

  .links {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-size: 0.9rem;

    a {
      color: var(--text-secondary);
      @include link-underline;
      &:hover { color: var(--text-primary); }
    }
  }

  .news {
    padding-bottom: 1.4rem;
  }

  .news-item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    align-items: baseline;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);

    time {
      color: var(--text-tertiary);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
  }

  button.news-latest {
    grid-template-columns: auto 1fr auto;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-fast) ease;

    .chevron {
      align-self: center;
      color: var(--text-tertiary);
    }

    &:hover {
      color: var(--text-primary);
    }
  }

  .news.expanded button.news-latest .chevron {
    transform: rotate(180deg);
  }

  // Same 0fr → 1fr row as the bio.
  .news-more {
    display: grid;
    overflow: hidden;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--dur-slow) var(--ease-out),
      opacity var(--dur-fast) ease,
      visibility 0s linear var(--dur-slow);

    .news-clip {
      min-height: 0;
    }

    // A long history scrolls inside its own box rather than pushing the posts away.
    ul {
      max-height: 14rem;
      overflow-y: auto;
      list-style: none;
    }

    li {
      margin-top: 0.3rem;
    }
  }

  .news.expanded .news-more {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows var(--dur-slow) var(--ease-out),
      opacity var(--dur-base) ease var(--dur-fast),
      visibility 0s;
  }

  .blog-section {
    padding: 1.5rem 0 5rem;
    border-top: 1px solid var(--border-color);
  }
</style>

<script>
  // Open/closed state goes through these two functions, which work on any
  // document: this page on a click, and the incoming page on a language switch
  // (so it arrives already looking the way this one was left).
  function setBio(doc: Document, expanded: boolean) {
    const wrap = doc.getElementById('bio-wrap');
    const toggle = doc.getElementById('bio-toggle');
    if (!wrap || !toggle) return;
    wrap.classList.toggle('expanded', expanded);
    toggle.setAttribute('aria-expanded', String(expanded));
    const label = toggle.querySelector('.bio-toggle-label');
    if (label) label.textContent = (expanded ? toggle.dataset.less : toggle.dataset.more) ?? '';
  }

  function setNews(doc: Document, expanded: boolean) {
    const news = doc.getElementById('news');
    const toggle = doc.getElementById('news-toggle');
    if (!news || !toggle) return;
    news.classList.toggle('expanded', expanded);
    toggle.setAttribute('aria-expanded', String(expanded));
  }

  const isOpen = (id: string) => !!document.getElementById(id)?.classList.contains('expanded');

  // Delegated from the document, so the handlers survive view-transition swaps.
  document.addEventListener('click', e => {
    const target = e.target as Element | null;
    if (target?.closest?.('#bio-toggle')) setBio(document, !isOpen('bio-wrap'));
    else if (target?.closest?.('#news-toggle')) setNews(document, !isOpen('news'));
  });

  document.addEventListener('site:carry-state', e => {
    const { next } = (e as CustomEvent<{ next: Document }>).detail;
    setBio(next, isOpen('bio-wrap'));
    setNews(next, isOpen('news'));
  });
</script>
