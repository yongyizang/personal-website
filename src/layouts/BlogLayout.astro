---
import BaseLayout from './BaseLayout.astro';
import { getLocaleFromUrl } from '../i18n/ui';

interface Author {
  name: string;
  affiliation?: string;
  url?: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  authors?: Author[];
  tags: string[];
  translationOf?: string;
  headings?: { depth: number; slug: string; text: string }[];
  toc?: boolean;
}

const { title, description, date, updated, authors = [], tags, translationOf, headings = [], toc = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const showToc = toc && tocHeadings.length >= 3;
---

<BaseLayout title={title} description={description}>
  <article class:list={['post-wrap', { 'has-toc': showToc }]}>
    <a href={`/${locale}/`} class="back">&larr; {locale === 'zh' ? '首页' : 'home'}</a>

    <header class="d-title">
      <h1>{title}</h1>
      {description && <p class="subtitle">{description}</p>}
    </header>

    <div class="d-byline">
      {authors.length > 0 && (
        <div class="byline-field">
          <h3>{locale === 'zh' ? '作者' : 'Authors'}</h3>
          <p class="byline-authors">
            {authors.map((a, i) => (
              <>
                {a.url ? (
                  <a href={a.url} target="_blank" rel="noopener" class="author-link">
                    {a.name}{a.affiliation && <span class="affiliation"> ({a.affiliation})</span>}
                  </a>
                ) : (
                  <span>
                    {a.name}{a.affiliation && <span class="affiliation"> ({a.affiliation})</span>}
                  </span>
                )}
                {i < authors.length - 1 && ', '}
              </>
            ))}
          </p>
        </div>
      )}
      <div class="byline-field">
        <h3>{locale === 'zh' ? '发布日期' : 'Published'}</h3>
        <p>
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </p>
      </div>
      {updated && (
        <div class="byline-field">
          <h3>{locale === 'zh' ? '更新日期' : 'Updated'}</h3>
          <p>
            <time datetime={updated.toISOString()}>
              {updated.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </p>
        </div>
      )}
    </div>

    <div class="post-body">
      {showToc && (
        <aside class="toc" id="toc">
          <nav>
            <h3>{locale === 'zh' ? '目录' : 'Contents'}</h3>
            <ul>
              {tocHeadings.map(h => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <div class="post-content">
        <slot />
      </div>
    </div>

  </article>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;

  .post-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* ── When TOC is present, widen and use grid ── */
  .post-wrap.has-toc {
    max-width: 1080px;
  }

  .back {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    &:hover { color: var(--text-primary); text-decoration: none; }
  }

  /* ── Title ── */
  .d-title {
    max-width: 720px;
    padding: 2rem 0 1.5rem;

    h1 {
      font-size: 2.25rem;
      font-weight: 700;
      line-height: 1.15;
    }
  }

  .subtitle {
    margin-top: 0.5rem;
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (min-width: $small-device) {
    .d-title h1 { font-size: 2.75rem; }
  }

  /* ── Byline ── */
  .d-byline {
    max-width: 720px;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.8rem;
    line-height: 1.8;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .byline-field {
    h3 {
      font-size: 0.6rem;
      font-weight: 400;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0;
    }

    p {
      margin: 0.15rem 0 0;
      font-weight: 500;
    }
  }

  .byline-authors {
    .affiliation {
      font-weight: 400;
      color: var(--text-secondary);
    }
    .author-link {
      text-decoration: none;
      &:hover { text-decoration: underline; }
    }
  }

  /* ── Post body: TOC + content grid ── */
  .post-body {
    margin-top: 2rem;
    display: block;
  }

  .has-toc .post-body {
    @media (min-width: 1080px) {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 3rem;
    }
  }

  /* ── TOC sidebar ── */
  .toc {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);

    @media (min-width: 1080px) {
      border-bottom: none;
      border-right: 1px solid var(--border-color);
      padding-right: 1.5rem;
      padding-bottom: 0;
      position: sticky;
      top: 5rem;
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }

    nav h3 {
      font-size: 0.7rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
      margin-bottom: 0.75rem;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    li {
      margin-bottom: 0.4rem;
    }

    li.depth-3 {
      padding-left: 1em;
    }

    a {
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      line-height: 1.4;
      &:hover { color: var(--text-primary); }
    }
  }

  /* ── Content ── */
  .post-content {
    max-width: 720px;
    font-size: 1.06rem;
    line-height: 1.7;

    :global(h2) {
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 1.25;
      margin: 2.5rem 0 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-color);
    }

    :global(h3) {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.4;
      margin: 2rem 0 0.75rem;
    }

    :global(h4) {
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      line-height: 1.4;
      margin: 1.5rem 0 0.5rem;
    }

    :global(p) { margin: 1rem 0; }
    :global(ul), :global(ol) { padding-left: 1.5em; margin: 1rem 0; }
    :global(li) { margin: 0.3rem 0; }
    :global(a) { text-decoration: underline; }
    :global(figure) { margin: 2rem 0; }
    :global(figure img) { width: 100%; border-radius: 4px; }
    :global(figcaption) { font-size: 0.8rem; line-height: 1.5; color: var(--text-secondary); margin-top: 0.5rem; }
    :global(img) { border-radius: 4px; margin: 1.5rem 0; max-width: 100%; }
    :global(blockquote) { border-left: 4px solid var(--border-color); margin: 1.5rem 0; padding: 0.75rem 1rem; font-style: italic; color: var(--text-secondary); }
    :global(pre) { margin: 1.5rem 0; border-radius: 6px; }
    :global(code) { font-family: $default-mono; }
    :global(details) { background: var(--code-bg); padding: 0.75rem 1rem; border-radius: 6px; margin: 1.25rem 0; }
    :global(details summary) { cursor: pointer; font-weight: 500; }
    :global(details p) { margin: 0.5rem 0; }
    :global(hr) { border: 0; border-top: 1px solid var(--border-color); margin: 2.5rem 0; }
  }

  @media (min-width: $small-device) {
    .post-content {
      :global(h2) { font-size: 1.75rem; }
      :global(h3) { font-size: 1.25rem; }
    }
  }

</style>

<script>
  function initCitations() {
    const cites = document.querySelectorAll('.cite-key');
    if (!cites.length) return;

    const keyMap = new Map<string, number>();
    let counter = 0;

    const refMap = new Map<string, string>();
    document.querySelectorAll('.ref-entry').forEach(li => {
      const id = li.getAttribute('id');
      if (id) refMap.set(id.replace('ref-', ''), li.textContent?.trim() || '');
    });

    cites.forEach(el => {
      const key = el.getAttribute('data-cite')!;
      if (!keyMap.has(key)) keyMap.set(key, ++counter);
      el.textContent = String(keyMap.get(key));
    });

    document.querySelectorAll('[data-cite-tooltip]').forEach(el => {
      const key = el.getAttribute('data-cite-tooltip')!;
      const num = keyMap.get(key);
      const text = refMap.get(key);
      if (num && text) el.textContent = `[${num}] ${text}`;
    });
  }

  initCitations();
  document.addEventListener('astro:after-swap', initCitations);
</script>
